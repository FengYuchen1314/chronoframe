# docker-compose.yml 无需 .env 即可启动。本文件仅用于覆盖可选运行参数；
# 数据库、主密钥和本地图片固定保存在 Compose 同目录的 ./data。
CHRONOFRAME_BIND=0.0.0.0
CHRONOFRAME_PORT=8188
CF_CONVERSION_WORKERS=4
# 直连 HTTP 使用 false。HTTPS 反向代理必须改为 true。
CF_COOKIE_SECURE=false
# 仅当后端端口只绑定 127.0.0.1，且受控代理会覆盖 Forwarded/X-Forwarded-* 时启用。
CF_TRUST_PROXY_HEADERS=false
