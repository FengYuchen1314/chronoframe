# 存储凭据加密主密钥文件。首次启动会自动生成 32 字节随机密钥；请随数据库一同备份，切勿删除或提交到 Git。
# 这只是密钥文件位置，WebDAV/S3 等存储配置仍全部在后台页面设置。
CF_MASTER_KEY_FILE=./data/secret.key
# auto 仅在已明确启用受信任代理头且代理报告 https 时为会话 Cookie 增加 Secure。
# HTTPS 反向代理也可显式设为 true；只有直接 HTTP 测试环境才使用 false。
CF_COOKIE_SECURE=auto
# 默认不信任客户端可伪造的 Forwarded / X-Forwarded-*。只有后端端口不对公网开放、
# 且反向代理会覆盖这些请求头时才设为 true。
CF_TRUST_PROXY_HEADERS=false
CF_DATABASE_URL=sqlite://data/chronoframe.db?mode=rwc
CF_CONVERSION_WORKERS=4
# 可选：服务监听地址。
CF_BIND_ADDR=0.0.0.0:8080
# Nuxt 静态构建产物路径；Docker 镜像内固定为 /app/web。
CF_WEB_DIR=./.output/public
